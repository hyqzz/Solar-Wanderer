-selector-button:hover{background-color:#b60109;cursor:pointer;transition:background-color .2s ease-in-out}.usa-article-content div.form-entry-content p.form-omb-approval-wrapper{margin:0}div.form-entry-content p.form-omb-approval-wrapper .form-omb-approval-label{font-size:.7rem;font-weight:700;margin-right:5px}div.form-entry-content p.form-omb-approval-wrapper .form-omb-approval-code{font-family:dm-mono;font-size:.9rem;font-style:normal;font-weight:500;letter-spacing:1px;line-height:1em;text-transform:uppercase}.gf_progressbar_wrapper{margin-bottom:16px}.gf_progressbar_title{color:#2e2e32;font-size:14px;font-weight:600;margin-bottom:8px}.gf_progressbar{background-color:#e6e6e6;border-radius:4px;height:20px;overflow:hidden}.gf_progressbar_percentage{background-color:#1c67e6;border-radius:4px;height:100%;text-align:center;transition:width .3s ease}.gf_progressbar_percentage span{color:#fff;display:block;font-size:12px;font-weight:600;line-height:20px}.hds-single-form-embed.bg-carbon-90 .form-entry-content{margin-bottom:40px;width:100%}.bg-carbon-90 .gform_fields .ginput_container span>*,.bg-carbon-90 .gform_fields .ginput_container>*{background:transparent;color:#d1d1d1}.bg-carbon-90 .gform_fields .ginput_container input::-moz-placeholder{color:#d1d1d1}.bg-carbon-90 .gform_fields .ginput_container input::placeholder{color:#d1d1d1}.bg-carbon-90 .gform_fields .gsection_title{border-bottom:1px solid #fff}.bg-carbon-90 .gform_fields .ginput_container_date:after{content:url(data:image/svg+xml;base64,)}.bg-carbon-90 .gform_fields .ginput_container_select:after{content:url(data:image/svg+xml;base64,)}.bg-carbon-90 .gf_progressbar_title,.bg-carbon-90 .gfield--type-html,.bg-carbon-90 .gfield--type-html a,.bg-carbon-90 .gform-field-label,.bg-carbon-90 .gform_fields .gfield_description,.bg-carbon-90 .gform_fields .gsection_description,.bg-carbon-90 .gform_required_legend,.bg-carbon-90 .gsection_title,.bg-carbon-90 h2{color:#d1d1d1}.bg-carbon-90 .gf_progressbar{background-color: